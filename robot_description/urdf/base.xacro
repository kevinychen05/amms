<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- Chassis dimensions (meters, kg) -->
  <xacro:property name="chassis_length" value="0.40"/>
  <xacro:property name="chassis_width" value="0.30"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="chassis_mass" value="5.0"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_thickness" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.2"/>

  <!-- Caster dimensions -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.1"/>

  <!-- base_footprint: massless ground-level reference frame (REP-105/Nav2
       convention). base_link (the chassis) sits one wheel radius above it,
       since that's the height of the wheel axles above the ground. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia
      mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"
      origin_xyz="0 0 ${chassis_height/2}" origin_rpy="0 0 0"/>
  </link>

  <!-- Wheel macro: instantiated once per side. The cylinder primitive's
       natural symmetry axis is local Z, but the wheel needs to roll about
       Y (REP-103: X=forward, Y=left, Z=up), so visual, collision, AND the
       inertial origin all apply the same 90-degree roll about X, keeping
       the three "consistent by construction" instead of by careful manual
       upkeep across two separate wheel copies. -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia
        mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_thickness}"
        origin_xyz="0 0 0" origin_rpy="1.5708 0 0"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * (chassis_width/2 + wheel_thickness/2)} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10.0" velocity="10.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- Caster: a passive support point, simplified as a low-friction sphere
       rather than a fully-modeled 2-joint swiveling caster mechanism. This
       is a deliberate simplification, not laziness: a caster's only job is
       to keep the robot from tipping over, and a frictionless sphere (set
       up in Gazebo in Phase 2) achieves equivalent behavior for planning
       and control purposes without the complexity of an extra link/joint
       pair whose orientation nothing in this project actually needs to
       know or control. -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia
      mass="${caster_mass}" radius="${caster_radius}"
      origin_xyz="0 0 0" origin_rpy="0 0 0"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-chassis_length/2 + caster_radius} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

</robot>
