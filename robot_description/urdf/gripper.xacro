<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parallel-jaw gripper: two fingers on prismatic (sliding) joints,
       mounted on gripper_mount_link. Only left_finger_joint is a real,
       independently-actuated DOF. right_finger_joint is a mimic joint:
       its position is always (-1.0 * left_finger_joint position), so it
       slides the opposite direction by the same amount. This models how
       most real parallel grippers work mechanically: one actuator drives
       both jaws through a linkage, rather than two independent motors
       that could fall out of sync. robot_state_publisher resolves mimic
       joints automatically from the URDF's <mimic> tag, so
       joint_state_publisher_gui correctly shows a slider for only the one
       real DOF, and the mimic finger is not independently controllable and
       has no slider of its own. -->

  <xacro:property name="finger_depth" value="0.02"/>
  <xacro:property name="finger_thickness" value="0.01"/>
  <xacro:property name="finger_height" value="0.06"/>
  <xacro:property name="finger_mass" value="0.05"/>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_mount_link"/>
    <child link="left_finger_link"/>
    <origin xyz="${gripper_mount_length} ${finger_thickness/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="10.0" velocity="0.1"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="${finger_depth/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_depth} ${finger_thickness} ${finger_height}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="${finger_depth/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_depth} ${finger_thickness} ${finger_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia
      mass="${finger_mass}" x="${finger_depth}" y="${finger_thickness}" z="${finger_height}"
      origin_xyz="${finger_depth/2} 0 0" origin_rpy="0 0 0"/>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_mount_link"/>
    <child link="right_finger_link"/>
    <origin xyz="${gripper_mount_length} ${-finger_thickness/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0.0" effort="10.0" velocity="0.1"/>
    <mimic joint="left_finger_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="${finger_depth/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_depth} ${finger_thickness} ${finger_height}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="${finger_depth/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_depth} ${finger_thickness} ${finger_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia
      mass="${finger_mass}" x="${finger_depth}" y="${finger_thickness}" z="${finger_height}"
      origin_xyz="${finger_depth/2} 0 0" origin_rpy="0 0 0"/>
  </link>

</robot>
