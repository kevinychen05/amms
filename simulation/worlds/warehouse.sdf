<?xml version="1.0"?>
<sdf version="1.10">
  <world name="warehouse">

    <!-- Gazebo Harmonic (gz-sim) requires each simulated capability to be
         explicitly loaded as a "System" plugin; nothing runs by default,
         unlike Gazebo Classic. Physics is the actual solver;
         UserCommands handles spawn/delete/teleport requests (what our
         robot-spawn step in Step 2 will use); SceneBroadcaster publishes
         scene/pose state to any connected GUI or ros_gz bridge;
         Sensors renders camera/lidar data (needed once we attach sensors
         in Steps 4-5, harmless to load now); Contact reports collision
         contact points, useful for later grasp-success checks. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Solver timestep: physics is advanced in 1ms increments (1000
         steps per second of simulated time). Smaller steps = more
         accurate contact/friction resolution but more CPU per second of
         sim time; 1ms is a standard default that balances the two for a
         ground robot. real_time_factor=1.0 is the *target* ratio of
         simulated-time to wall-clock-time (1.0 = try to run at real
         speed); if the solver can't keep up, sim time will simply fall
         behind wall time rather than skipping steps. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane. mu/mu2 are the Coulomb friction coefficients along
         the two surface tangent directions; this is what lets the
         differential-drive wheels actually roll instead of spinning in
         place with no traction (a robot with correct wheel inertia from
         Phase 1 but a frictionless floor still won't move). 0.8 is a
         reasonable rubber-on-concrete-ish value. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter walls: a 10m x 10m enclosed room, so Nav2 (Phase 3) has
         a bounded space to map rather than an infinite open plane. Each
         wall is a thin static box; static="true" means Gazebo excludes it
         from physics integration entirely (it can't move, so there's no
         point computing dynamics for it), which is cheaper than a
         zero-velocity dynamic body. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Interior obstacles: two "shelf" blocks and one pillar, positioned
         diagonally across the room from each other (not forming a
         corridor with each other, despite what an earlier version of
         this comment claimed: the tightest gap between any two of
         these, or between one of these and a wall, is over 2m, too open
         to exercise costmap-inflation-vs-corridor-width tuning). Colored
         distinctly (not gray like the walls) purely so a human watching
         the sim can tell obstacles apart from walls at a glance. The
         partition wall below, added in Phase 3, is what actually
         provides a real narrow passage. -->
    <model name="shelf_a">
      <static>true</static>
      <pose>-1.5 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 0.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.5 1</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_b">
      <static>true</static>
      <pose>1.5 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 0.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.5 1</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>2.5 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Additional warehouse dressing, added when expanding the room
         past Phase 2's original sparse layout. Gives each half of the
         partition wall below its own character (west: crate cluster +
         second pillar; east: second shelf) and more varied SLAM
         landmarks (a clustered group of small boxes reads very
         differently in a lidar scan than one long shelf), while staying
         clear of the partition's narrow passage and every existing
         obstacle; checked individually below, not just placed by eye. -->

    <model name="crate_1">
      <static>true</static>
      <pose>-3.2 -3.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.7 0.6 0.2 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>-2.6 -3.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.7 0.6 0.2 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_3">
      <static>true</static>
      <pose>-2.9 -2.6 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.7 0.6 0.2 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-3.5 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_c">
      <static>true</static>
      <pose>3.5 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 2 1</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition wall along x=0, splitting the room into east/west
         halves connected only through a 1.0m gap centered at y=0, a
         genuine narrow passage (Phase 2's shelves, despite that
         package's original comment, never actually formed one; see
         above). 1.0m was chosen deliberately: our robot's footprint is
         only 0.4m long, so a naive inflation_radius (Phase 3's default,
         copied from nav2_bringup's TB3 reference, is 0.70m) inflating
         0.70m in from EACH side would overlap by 0.4m in the middle of
         this exact gap, giving a concrete, room-specific way to observe
         and fix the "over-tightened inflation blocks a passable
         corridor" pitfall, rather than only demonstrating it in the
         abstract. -->
    <model name="partition_south">
      <static>true</static>
      <pose>0 -2.75 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4.5 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.5 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_north">
      <static>true</static>
      <pose>0 2.75 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4.5 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.5 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
